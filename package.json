{
  "name": "sidegig",
  "version": "0.3.0",
  "private": true,
  "description": "A free, open-source sidebar that lives in the margin of every browser: hover the edge for your apps, AI, bookmark stacks and search.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:opera": "node scripts/build.mjs opera",
    "build:safari": "node scripts/build.mjs safari",
    "zip": "node scripts/build.mjs --zip",
    "preview": "node scripts/build.mjs preview",
    "check": "tsc --noEmit -p .",
    "edition:dry-run": "node scripts/edition-dry-run.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "safari": "npm run build:safari && xcrun safari-web-extension-converter dist/safari --project-location safari-xcode --app-name sidegig --bundle-identifier com.neerajbhargav.sidegig --macos-only --no-prompt --force",
    "figures": "node scripts/build-figures.mjs",
    "snap": "node scripts/evolution.mjs add",
    "changelog": "node scripts/evolution.mjs changelog",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "esbuild-wasm": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "esbuild": "^0.28.2"
  }
}
