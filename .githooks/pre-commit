#!/bin/sh
# sidegig: remind whoever commits to keep the project history fresh (never blocks).
# Enabled by `git config core.hooksPath .githooks` (npm install does this via "prepare").
# CHANGELOG.md is regenerated on main after a merge (npm run changelog), not per
# commit: a per-branch copy is always one commit behind and conflicts on every merge.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -qE '^src/(ui|content|options)/.*\.(ts|css|html)$' && ! echo "$staged" | grep -q '^docs/evolution/'; then
  echo "sidegig: this commit changes what users see. Add a screenshot: npm run snap -- <image> \"<caption>\"" >&2
fi
if echo "$staged" | grep -qE '^(src|bridge|scripts)/' && ! echo "$staged" | grep -q '^docs/STATUS.md$'; then
  echo "sidegig: update docs/STATUS.md (Where work stopped) if this changes the state of the work." >&2
fi
exit 0
